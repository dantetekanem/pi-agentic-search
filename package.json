{
  "name": "pi-agentic-search",
  "version": "0.5.0",
  "description": "Pi extension for agent-oriented ranked code search and one-call diff context packs",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/dantetekanem/pi-agentic-search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dantetekanem/pi-agentic-search.git"
  },
  "bugs": {
    "url": "https://github.com/dantetekanem/pi-agentic-search/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agentic-search",
    "code-search",
    "ripgrep"
  ],
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs/access.md",
    "index.ts",
    "src"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "tsx test/smoke.ts && tsx test/sparsity.ts && tsx test/sparsity-scan.ts && tsx test/ruby-adapter.ts && tsx test/ruby-index.ts && tsx test/ts-adapter.ts && tsx test/rank.ts",
    "benchmark": "node --import tsx test/benchmark.ts",
    "test:benchmark": "node --import tsx test/benchmark-metrics.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "@ruby/prism": "^1.9.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.74.0",
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@earendil-works/pi-tui": "0.74.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typebox": "^1.1.24"
  }
}
