{
  "name": "pi-agentic-search",
  "version": "0.7.1",
  "description": "Ranked code search and diff context packs for coding agents, as a CLI and Pi tools",
  "bin": { "agentic-search": "./bin/agentic-search.mjs" },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/dantetekanem/pi-agentic-search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dantetekanem/pi-agentic-search.git"
  },
  "bugs": {
    "url": "https://github.com/dantetekanem/pi-agentic-search/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agentic-search",
    "code-search",
    "ripgrep"
  ],
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "docs/access.md",
    "index.ts",
    "src",
    "bin",
    "dist",
    "tsconfig.json",
    "tsconfig.cli.json",
    "skills"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": ["./skills"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.cli.json",
    "prepack": "tsc -p tsconfig.cli.json",
    "test:cli": "tsc -p tsconfig.cli.json && node --import tsx --test test/cli.test.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.cli.json && node --import tsx --test test/*.test.ts",
    "smoke": "tsx test/smoke.ts && tsx test/sparsity.ts && tsx test/sparsity-scan.ts && tsx test/ruby-adapter.ts && tsx test/ruby-index.ts && tsx test/ts-adapter.ts && tsx test/rank.ts",
    "benchmark": "node --import tsx test/benchmark.ts",
    "test:benchmark": "node --import tsx test/benchmark-metrics.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "dependencies": {
    "@ruby/prism": "^1.9.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.74.0",
    "@earendil-works/pi-coding-agent": "0.74.0",
    "@earendil-works/pi-tui": "0.74.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typebox": "^1.1.24"
  }
}
